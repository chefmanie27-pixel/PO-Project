# Populate from an existing Web app with: npm run firebase:configure
# Never put Admin SDK credentials or private keys in VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Empty for local Vite proxy or combined hosting; HTTPS backend origin for a separate static site.
VITE_API_BASE_URL=
