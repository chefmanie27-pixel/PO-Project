# Local PostgreSQL only; configure the intended database privately.
DATABASE_URL=postgresql://localhost:5432/po_command_center
PORT=4000
WEB_ORIGIN=http://localhost:5173
HOST=127.0.0.1
SERVE_FRONTEND=false
NODE_ENV=development
APP_ENV=local
TRUST_PROXY=false
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
# Optional explicit server credentials instead of the service account file.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Manual one-time administrator bootstrap, never automatic on login/startup.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_UID=
BOOTSTRAP_ADMIN_EMAIL=
# Public frontend values; never put Admin or database credentials in VITE_ variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_API_BASE_URL=
# Render supplies PORT. Configure production variables in Render, not this file.
# See docs/auth-provisioning.md and docs/deployment.md.
