{
  "name": "po-command-center",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "firebase:inspect": "node scripts/firebase-inspect.mjs",
    "firebase:configure": "node scripts/firebase-configure.mjs",
    "firebase:check": "node scripts/firebase-check.mjs",
    "test:firebase:emulators": "node scripts/firebase-emulators.mjs",
    "test:auth:integration": "vitest run --config vitest.auth-integration.config.ts",
    "test:auth:browser": "playwright test --config playwright.auth.config.ts",
    "db:bootstrap": "tsx backend/prisma/bootstrap.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write frontend/src backend/src backend/tests frontend/tests shared e2e docs *.md *.json *.ts *.js",
    "dev": "concurrently -k \"npm:dev:*\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "tsc --noEmit -p backend && tsc --noEmit -p frontend",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:seed": "tsx backend/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "pino-http": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.0"
  }
}
