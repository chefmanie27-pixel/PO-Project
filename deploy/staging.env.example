# Template only. Keep the filled file outside the release bundle and repository.
NODE_ENV=production
APP_ENV=staging
PORT=4000
WEB_ORIGIN=https://staging.example.com
TRUST_PROXY=loopback
# Use a separate staging database, never the existing development/production database.
DATABASE_URL=
# Reuse an explicitly authorized existing Firebase project; do not create one automatically.
FIREBASE_PROJECT_ID=
# Absolute path to a private service-account file outside the app directory,
# or use the hosting provider's supported application default credentials.
GOOGLE_APPLICATION_CREDENTIALS=
# Only for a separately authorized trusted bootstrap, never run automatically.
BOOTSTRAP_ADMIN_UID=
BOOTSTRAP_ADMIN_EMAIL=
